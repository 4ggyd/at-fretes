<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.web.WebView?>

<HBox alignment="CENTER" spacing="20.0" prefWidth="950.0" prefHeight="600.0" 
      xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="br.ufrn.imd.atfretes.controller.FreteFxController"
      style="-fx-background-color: #f4f6f9;">
    
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <VBox spacing="15.0" prefWidth="400.0" alignment="TOP_CENTER" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
        
        <Label text="Cálculo de Fretes Pro" textFill="#2c3e50">
            <font>
                <Font name="System Bold" size="20.0"/>
            </font>
        </Label>

        <GridPane hgap="10.0" vgap="12.0" alignment="CENTER">
            <Label text="CEP Origem:" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <font><Font size="13.0"/></font>
            </Label>
            <TextField fx:id="txtCepOrigem" promptText="00000-000" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <font><Font size="13.0"/></font>
            </TextField>

            <Label text="CEP Destino:" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <font><Font size="13.0"/></font>
            </Label>
            <TextField fx:id="txtCepDestino" promptText="00000-000" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <font><Font size="13.0"/></font>
            </TextField>

            <Label text="Peso (kg):" GridPane.columnIndex="0" GridPane.rowIndex="2">
                <font><Font size="13.0"/></font>
            </Label>
            <TextField fx:id="txtPeso" promptText="0.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <font><Font size="13.0"/></font>
            </TextField>

            <Label text="Valor Declarado:" GridPane.columnIndex="0" GridPane.rowIndex="3">
                <font><Font size="13.0"/></font>
            </Label>
            <TextField fx:id="txtValorDeclarado" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="3">
                <font><Font size="13.0"/></font>
            </TextField>
        </GridPane>

        <Button fx:id="btnCalcular" text="Calcular Rota e Frete" onAction="#handleCalcularFrete"
                style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-cursor: hand;" prefWidth="220.0">
            <font>
                <Font name="System Bold" size="14.0"/>
            </font>
        </Button>

        <VBox spacing="8.0" alignment="CENTER" style="-fx-border-color: #e2e8f0; -fx-border-radius: 5; -fx-padding: 12; -fx-background-color: #f8fafc;">
            <Label text="Detalhamento do Frete Real:" textFill="#64748b">
                <font><Font name="System Bold" size="11.0"/></font>
            </Label>
            <Label fx:id="lblResultado" text="Insira os dados para gerar o trajeto" textFill="#1e293b" wrapText="true" alignment="CENTER">
                <font>
                    <Font size="13.0"/>
                </font>
            </Label>
        </VBox>
    </VBox>

    <VBox prefWidth="510.0" spacing="10.0" HBox.hgrow="ALWAYS">
        <Label text="Trajeto Estimado da Carga" textFill="#34495e">
            <font>
                <Font name="System Bold" size="14.0"/>
            </font>
        </Label>
        <WebView fx:id="mapView" prefHeight="530.0" prefWidth="510.0" style="-fx-border-color: #cbd5e1; -fx-border-radius: 8;" VBox.vgrow="ALWAYS" />
    </VBox>
</HBox>